  "chapters": [
    {
      "id": "01-operation",
      "duration": 10,
      "group": 0,
      "title": "ARX / 6",
      "subtitle": "Compact drives. Independent payload. Fresh physical solve.",
      "note": "RECORDED DYNAMICS \u00b7 TWO TRANSFERS",
      "start": 0,
      "end": 10
    },
    {
      "id": "02-disassembly",
      "duration": 6,
      "group": 0,
      "title": "Every assembly, revealed",
      "subtitle": "The same CAD parts separate along service and inspection directions.",
      "note": "VISUAL DISASSEMBLY \u00b7 ALL RIGID PARTS",
      "start": 10,
      "end": 16
    },
    {
      "id": "03-base",
      "duration": 5,
      "group": 1,
      "title": "01 / Base rotation",
      "subtitle": "Folded motor and reducer \u2192 toothed belt \u2192 output shaft.",
      "note": "DIRECT OUTPUT BRAKE \u00b7 ADJUSTABLE BELT CARRIER",
      "start": 16,
      "end": 21
    },
    {
      "id": "04-shoulder",
      "duration": 6,
      "group": 2,
      "title": "02 / Shoulder drive",
      "subtitle": "The full-size drive folds beside the joint instead of projecting outward.",
      "note": "5M BELT \u00b7 36T PULLEYS \u00b7 25 MM WIDTH",
      "start": 21,
      "end": 27
    },
    {
      "id": "05-elbow",
      "duration": 6,
      "group": 3,
      "title": "03 / Elbow drive",
      "subtitle": "The belt transfers reducer torque; the brake acts directly on the output.",
      "note": "REMOVABLE COVER \u00b7 SUPPORTED INPUT SHAFT",
      "start": 27,
      "end": 33
    },
    {
      "id": "06-shoulder-balance",
      "duration": 4,
      "group": 8,
      "title": "Shoulder counterbalance",
      "subtitle": "Paired extension springs support the arm through its changing lever arm.",
      "note": "ACTUAL MOVING ANCHORS \u00b7 RECORDED JOINT MOTION",
      "start": 33,
      "end": 37
    },
    {
      "id": "07-elbow-balance",
      "duration": 4,
      "group": 9,
      "title": "Elbow counterbalance",
      "subtitle": "The fixed anchor moves below the elbow; the raised mast is removed.",
      "note": "COMPACT TAIL ARM \u00b7 PAIRED SPRINGS",
      "start": 37,
      "end": 41
    },
    {
      "id": "08-wrist-roll",
      "duration": 4,
      "group": 4,
      "title": "04 / Wrist roll",
      "subtitle": "A smaller folded transmission turns the wrist about the forearm axis.",
      "note": "3M BELT \u00b7 30T PULLEYS \u00b7 15 MM WIDTH",
      "start": 41,
      "end": 45
    },
    {
      "id": "09-wrist-bend",
      "duration": 4,
      "group": 5,
      "title": "05 / Wrist bend",
      "subtitle": "The fork, bearings and output brake support the bend axis.",
      "note": "ISOLATED MECHANISM \u00b7 SECTIONED HOUSINGS",
      "start": 45,
      "end": 49
    },
    {
      "id": "10-tool-roll",
      "duration": 4,
      "group": 6,
      "title": "06 / Tool roll",
      "subtitle": "The final folded stage rotates the tool without the former axial stack.",
      "note": "FULL MOTOR ENVELOPE \u00b7 SHORTER AXIAL PACKAGE",
      "start": 49,
      "end": 53
    },
    {
      "id": "11-gripper",
      "duration": 6,
      "group": 7,
      "title": "Rack-and-pinion gripper",
      "subtitle": "One pinion moves opposed racks; guided jaws transmit force through the pads.",
      "note": "MECHANISM INSPECTION \u00b7 RECORDED JAW POSITIONS",
      "start": 53,
      "end": 59
    },
    {
      "id": "12-fixtures",
      "duration": 4,
      "group": 10,
      "title": "Payload and receiving nests",
      "subtitle": "The puck remains a free rigid body. Friction and contact determine its motion.",
      "note": "NO KINEMATIC ATTACHMENT \u00b7 NO HIDDEN PAYLOAD WELD",
      "start": 59,
      "end": 63
    },
    {
      "id": "13-structure",
      "duration": 4,
      "group": 11,
      "title": "Links and load path",
      "subtitle": "Rigid links carry joint reactions between the bearings and tool.",
      "note": "CAD-DERIVED SOLIDS \u00b7 INDIVIDUAL FASTENERS RETAINED",
      "start": 63,
      "end": 67
    },
    {
      "id": "14-reassembly",
      "duration": 5,
      "group": 0,
      "title": "ARX / 6 \u00b7 P5",
      "subtitle": "Compact engineered prototype. CAD, dynamics and renderer share one revision.",
      "note": "REASSEMBLY \u00b7 SOURCE AND VALIDATION INCLUDED",
      "start": 67,
      "end": 72
    }
  ],
